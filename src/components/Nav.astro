---
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { href: "features.html", key: "features", label: "Features" },
  { href: "setup.html", key: "setup", label: "Setup" },
  { href: "guide.html", key: "guide", label: "Using it" },
  { href: "privacy.html", key: "privacy", label: "Privacy" },
];
---
<header class="nav">
  <div class="wrap">
    <a class="logo" href={base} aria-label="Sidecar home">
      <span class="mark">
        <svg viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="30" height="30">
          <defs><linearGradient id="navmark" x1="0.1" y1="0" x2="0.5" y2="1"><stop offset="0" stop-color="#5aa89b"/><stop offset="0.52" stop-color="#3a7d72"/><stop offset="1" stop-color="#255851"/></linearGradient></defs>
          <rect width="128" height="128" rx="27" fill="url(#navmark)"/>
          <rect x="21" y="29" width="53" height="70" rx="11" fill="#fff"/><rect x="80" y="45" width="27" height="54" rx="8" fill="#fff"/>
          <rect x="30" y="46" width="30" height="5" rx="2.5" fill="#357168" opacity="0.32"/><rect x="30" y="58" width="35" height="5" rx="2.5" fill="#357168" opacity="0.32"/>
          <rect x="86" y="59" width="14" height="5" rx="2.5" fill="#2f8175"/><rect x="86" y="71" width="10" height="5" rx="2.5" fill="#2f8175"/><circle cx="88.5" cy="87" r="3.4" fill="#e0a838"/>
        </svg>
      </span>
      <span class="name">Sidecar</span>
    </a>
    <nav>
      {links.map((l) => (
        <a href={`${base}${l.href}`} class={active === l.key ? "active" : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
